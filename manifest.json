{
  "name": "MSG Viewer",
  "short_name": "MSG Viewer",
  "description": "Offline and secure viewer for .msg files on Windows",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#0b0f19",
  "theme_color": "#2563eb",
  "icons": [
    {
      "src": "docs/images/msg-viewer-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "docs/images/msg-viewer-icon.png",
      "sizes": "96x96",
      "type": "image/png"
    },
    {
      "src": "favicon.ico",
      "sizes": "16x16 24x24 32x32 48x48 64x64 96x96 128x128 256x256",
      "type": "image/x-icon"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/octet-stream": [
          ".msg"
        ]
      }
    }
  ]
}