{
  "name": "MSG Viewer",
  "short_name": "MSG Viewer",
  "description": "Offline and secure viewer for .msg files on Windows",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#0b0f19",
  "theme_color": "#2563eb",
  "icons": [
    {
      "src": "favicon.ico",
      "sizes": "64x64 32x32 24x24 16x16",
      "type": "image/x-icon"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/octet-stream": [
          ".msg"
        ]
      }
    }
  ]
}